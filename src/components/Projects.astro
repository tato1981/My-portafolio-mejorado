---
// Projects.astro - Rediseñado editorial monocromo
---

<section id="projects" class="py-12 md:py-16 relative">
    <div class="container mx-auto px-4">
        <!-- Encabezado Editorial con Nº -->
        <div class="section-header animate-[fadeInUp_0.6s_ease-out]">
            <div class="section-header-inner">
                <div class="section-header-title">
                    <div class="flex items-center gap-3 mb-1">
                        <span class="section-number">03</span>
                        <hr class="section-divider" />
                    </div>
                    <h2>Mis Proyectos</h2>
                    <p>Soluciones empresariales desarrolladas bajo principios de modularidad, eficiencia y seguridad de datos.</p>
                </div>
            </div>
        </div>

        <!-- Cuadrícula de Proyectos -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-16 max-w-7xl mx-auto">
            <!-- Proyecto 1 -->
            <div class="cyber-card !p-0 overflow-hidden flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--accent-color)] border border-[var(--accent-border)] bg-[#040508]/80 backdrop-blur-md px-1.5 py-0.5 rounded select-none z-10">[SYS_OK]</div>
                <div>
                    <div class="aspect-video relative overflow-hidden bg-[var(--tech-tag-bg)] border-b border-[var(--border-color)]">
                        <img
                            src="/images/gestion de ventas.png"
                            alt="Sistema de Gestión de Ventas"
                            loading="lazy"
                            class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
                        >
                    </div>
                    <div class="p-6">
                        <div class="font-mono text-[9px] text-[var(--text-subtle)] mb-1">[REPO: SALES_ERP_V2]</div>
                        <h3 class="text-xl font-bold mb-2 text-[var(--text-color)]">Sistema de Gestión de Ventas</h3>
                        <p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">
                            Plataforma empresarial para la gestión integral de inventarios, facturación, control de stock y reportes financieros analíticos.
                        </p>
                    </div>
                </div>
                <div class="p-6 pt-0">
                    <div class="flex flex-wrap mb-4">
                        <span class="tech-tag">React</span>
                        <span class="tech-tag">Node.js</span>
                        <span class="tech-tag">Express</span>
                        <span class="tech-tag">MongoDB</span>
                        <span class="tech-tag">JWT Auth</span>
                    </div>
                    <div class="flex justify-between items-center text-xs font-semibold pt-3 border-t border-[var(--border-color)]">
                        <span class="text-[var(--accent-color)] flex items-center gap-1 font-mono">
                            <i class="fas fa-calendar"></i> 2025
                        </span>
                        <span class="text-[var(--text-muted)] flex items-center gap-1 font-mono">
                            <i class="fas fa-lock"></i> Interno / Privado
                        </span>
                    </div>
                </div>
            </div>

            <!-- Proyecto 2 -->
            <div class="cyber-card !p-0 overflow-hidden flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--accent-color)] border border-[var(--accent-border)] bg-[#040508]/80 backdrop-blur-md px-1.5 py-0.5 rounded select-none z-10">[SYS_OK]</div>
                <div>
                    <div class="aspect-video relative overflow-hidden bg-[var(--tech-tag-bg)] border-b border-[var(--border-color)]">
                        <img
                            src="/images/sistema recordatorios.png"
                            alt="Sistema de Recordatorios"
                            loading="lazy"
                            class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
                        >
                    </div>
                    <div class="p-6">
                        <div class="font-mono text-[9px] text-[var(--text-subtle)] mb-1">[REPO: ALERT_SYSTEM_V1]</div>
                        <h3 class="text-xl font-bold mb-2 text-[var(--text-color)]">Sistema de Alertas Inteligente</h3>
                        <p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">
                            Aplicación web progresiva orientada a la calendarización de tareas corporativas con notificaciones push y sincronización cloud.
                        </p>
                    </div>
                </div>
                <div class="p-6 pt-0">
                    <div class="flex flex-wrap mb-4">
                        <span class="tech-tag">Vue.js</span>
                        <span class="tech-tag">Firebase</span>
                        <span class="tech-tag">PWA</span>
                        <span class="tech-tag">Cloud Functions</span>
                        <span class="tech-tag">FCM</span>
                    </div>
                    <div class="flex justify-between items-center text-xs font-semibold pt-3 border-t border-[var(--border-color)]">
                        <span class="text-[var(--accent-color)] flex items-center gap-1 font-mono">
                            <i class="fas fa-calendar"></i> 2025
                        </span>
                        <span class="text-[var(--text-muted)] flex items-center gap-1 font-mono">
                            <i class="fas fa-lock"></i> Interno / Privado
                        </span>
                    </div>
                </div>
            </div>

            <!-- Proyecto 3 -->
            <div class="cyber-card !p-0 overflow-hidden flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--accent-color)] border border-[var(--accent-border)] bg-[#040508]/80 backdrop-blur-md px-1.5 py-0.5 rounded select-none z-10">[SYS_OK]</div>
                <div>
                    <div class="aspect-video relative overflow-hidden bg-[var(--tech-tag-bg)] border-b border-[var(--border-color)]">
                        <img
                            src="/images/sistema hotelero.png"
                            alt="Sistema de Gestión Hotelera"
                            loading="lazy"
                            class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
                        >
                    </div>
                    <div class="p-6">
                        <div class="font-mono text-[9px] text-[var(--text-subtle)] mb-1">[REPO: HOTEL_ERP_SEC]</div>
                        <h3 class="text-xl font-bold mb-2 text-[var(--text-color)]">Sistema de Gestión Hotelera</h3>
                        <p class="text-sm text-[var(--text-muted)] mb-4 leading-relaxed">
                            ERP hotelero que integra motor de reservas online en vivo, control de disponibilidad de habitaciones, facturación automatizada y roles.
                        </p>
                    </div>
                </div>
                <div class="p-6 pt-0">
                    <div class="flex flex-wrap mb-4">
                        <span class="tech-tag">Angular</span>
                        <span class="tech-tag">Python</span>
                        <span class="tech-tag">Django</span>
                        <span class="tech-tag">PostgreSQL</span>
                        <span class="tech-tag">Redis Cache</span>
                    </div>
                    <div class="flex justify-between items-center text-xs font-semibold pt-3 border-t border-[var(--border-color)]">
                        <span class="text-[var(--accent-color)] flex items-center gap-1 font-mono">
                            <i class="fas fa-calendar"></i> 2025
                        </span>
                        <span class="text-[var(--text-muted)] flex items-center gap-1 font-mono">
                            <i class="fas fa-lock"></i> Interno / Privado
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Infraestructura y Soluciones -->
        <div class="max-w-7xl mx-auto">
            <h3 class="text-2xl font-bold mb-8 text-[var(--text-color)] text-center">Infraestructura y Soluciones</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
                <div class="cyber-card text-center">
                    <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[INF: MOBILE]</div>
                    <div class="icon-box mx-auto mb-4">
                        <i class="fas fa-mobile-screen-button"></i>
                    </div>
                    <h4 class="font-bold mb-1 text-[var(--text-color)]">Aplicaciones Móviles</h4>
                    <p class="text-xs text-[var(--text-muted)] leading-relaxed">Interfaces híbridas rápidas y robustas con React Native.</p>
                </div>
                <div class="cyber-card text-center">
                    <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[INF: CLOUD]</div>
                    <div class="icon-box mx-auto mb-4">
                        <i class="fas fa-cloud-arrow-up"></i>
                    </div>
                    <h4 class="font-bold mb-1 text-[var(--text-color)]">Soluciones Cloud</h4>
                    <p class="text-xs text-[var(--text-muted)] leading-relaxed">Despliegue y administración segura en AWS, Azure y GCP.</p>
                </div>
                <div class="cyber-card text-center">
                    <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[INF: SEC]</div>
                    <div class="icon-box mx-auto mb-4">
                        <i class="fas fa-shield-halved"></i>
                    </div>
                    <h4 class="font-bold mb-1 text-[var(--text-color)]">Seguridad Web</h4>
                    <p class="text-xs text-[var(--text-muted)] leading-relaxed">Implementación de cabeceras seguras y saneamiento de entradas.</p>
                </div>
                <div class="cyber-card text-center">
                    <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[INF: DATA]</div>
                    <div class="icon-box mx-auto mb-4">
                        <i class="fas fa-database"></i>
                    </div>
                    <h4 class="font-bold mb-1 text-[var(--text-color)]">Optimización SQL/NoSQL</h4>
                    <p class="text-xs text-[var(--text-muted)] leading-relaxed">Normalización, indexación y diseño de bases de datos.</p>
                </div>
            </div>
        </div>
    </div>
</section>
