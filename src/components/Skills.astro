---
// Skills.astro - Rediseñado editorial monocromo
---

<section id="skills" class="py-12 md:py-16 relative bg-[var(--bg-secondary)]">
    <div class="container mx-auto px-4">
        <!-- Encabezado Editorial con Nº -->
        <div class="section-header animate-[fadeInUp_0.6s_ease-out]">
            <div class="section-header-inner">
                <div class="section-header-title">
                    <div class="flex items-center gap-3 mb-1">
                        <span class="section-number">02</span>
                        <hr class="section-divider" />
                    </div>
                    <h2>Mis Habilidades</h2>
                    <p>Especialización técnica en desarrollo de software seguro y hacking ético.</p>
                </div>
            </div>
        </div>

        <!-- Cuadrícula Bento de Habilidades -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 mb-16 max-w-7xl mx-auto">
            <div class="cyber-card flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--text-subtle)] select-none">[SKILL: FE_CORE]</div>
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="icon-box">
                            <i class="fas fa-code"></i>
                        </span>
                        <h3 class="text-xl font-bold text-[var(--text-color)]">Desarrollo Frontend</h3>
                    </div>
                    <p class="text-sm text-[var(--text-muted)] mb-5 leading-relaxed">
                        Creación de interfaces web altamente interactivas, responsivas y accesibles con altos estándares de usabilidad.
                    </p>
                </div>
                <div>
                    <div class="flex flex-wrap">
                        <span class="tech-tag">HTML5</span>
                        <span class="tech-tag">CSS3</span>
                        <span class="tech-tag">JavaScript</span>
                        <span class="tech-tag">React</span>
                        <span class="tech-tag">Astro</span>
                        <span class="tech-tag">Tailwind CSS</span>
                    </div>
                </div>
            </div>

            <div class="cyber-card flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--text-subtle)] select-none">[SKILL: BE_SYS]</div>
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="icon-box">
                            <i class="fas fa-server"></i>
                        </span>
                        <h3 class="text-xl font-bold text-[var(--text-color)]">Desarrollo Backend</h3>
                    </div>
                    <p class="text-sm text-[var(--text-muted)] mb-5 leading-relaxed">
                        Diseño e implementación de servicios REST y arquitecturas de microservicios robustas y altamente escalables.
                    </p>
                </div>
                <div>
                    <div class="flex flex-wrap">
                        <span class="tech-tag">Node.js</span>
                        <span class="tech-tag">Express.js</span>
                        <span class="tech-tag">Python</span>
                        <span class="tech-tag">PostgreSQL</span>
                        <span class="tech-tag">MongoDB</span>
                        <span class="tech-tag">Firebase</span>
                    </div>
                </div>
            </div>

            <div class="cyber-card flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--text-subtle)] select-none">[SKILL: SEC_OFNS]</div>
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="icon-box">
                            <i class="fas fa-user-secret"></i>
                        </span>
                        <h3 class="text-xl font-bold text-[var(--text-color)]">Hacking Ético</h3>
                    </div>
                    <p class="text-sm text-[var(--text-muted)] mb-5 leading-relaxed">
                        Simulación de ciberataques reales para identificar vectores de riesgo y proponer remediaciones antes de incidentes.
                    </p>
                </div>
                <div>
                    <div class="flex flex-wrap">
                        <span class="tech-tag">Pen Testing</span>
                        <span class="tech-tag">Red Teaming</span>
                        <span class="tech-tag">Kali Linux</span>
                        <span class="tech-tag">Metasploit</span>
                        <span class="tech-tag">Nmap</span>
                        <span class="tech-tag">Ing. Social</span>
                    </div>
                </div>
            </div>

            <div class="cyber-card flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--text-subtle)] select-none">[SKILL: APP_SEC]</div>
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="icon-box">
                            <i class="fas fa-shield-halved"></i>
                        </span>
                        <h3 class="text-xl font-bold text-[var(--text-color)]">Seguridad Web (AppSec)</h3>
                    </div>
                    <p class="text-sm text-[var(--text-muted)] mb-5 leading-relaxed">
                        Auditoría y remediación de vulnerabilidades web basadas en el estándar industrial OWASP Top 10.
                    </p>
                </div>
                <div>
                    <div class="flex flex-wrap">
                        <span class="tech-tag">Burp Suite</span>
                        <span class="tech-tag">OWASP Top 10</span>
                        <span class="tech-tag">SAST / DAST</span>
                        <span class="tech-tag">Criptografía</span>
                    </div>
                </div>
            </div>

            <div class="cyber-card flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--text-subtle)] select-none">[SKILL: CLOUD_OPS]</div>
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="icon-box">
                            <i class="fas fa-cloud"></i>
                        </span>
                        <h3 class="text-xl font-bold text-[var(--text-color)]">DevSecOps &amp; Cloud</h3>
                    </div>
                    <p class="text-sm text-[var(--text-muted)] mb-5 leading-relaxed">
                        Automatización e integración de pruebas de seguridad directamente en pipelines CI/CD e infraestructura cloud.
                    </p>
                </div>
                <div>
                    <div class="flex flex-wrap">
                        <span class="tech-tag">Docker</span>
                        <span class="tech-tag">CI/CD</span>
                        <span class="tech-tag">AWS</span>
                        <span class="tech-tag">Linux Admin</span>
                        <span class="tech-tag">Auditoría Cloud</span>
                    </div>
                </div>
            </div>

            <div class="cyber-card flex flex-col justify-between">
                <div class="absolute top-2 right-3 font-mono text-[9px] text-[var(--text-subtle)] select-none">[SKILL: FORNS_SYS]</div>
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="icon-box">
                            <i class="fas fa-magnifying-glass-chart"></i>
                        </span>
                        <h3 class="text-xl font-bold text-[var(--text-color)]">Análisis Forense</h3>
                    </div>
                    <p class="text-sm text-[var(--text-muted)] mb-5 leading-relaxed">
                        Análisis de logs y recolección de evidencias tras fallos de seguridad o intrusiones de red no autorizadas.
                    </p>
                </div>
                <div>
                    <div class="flex flex-wrap">
                        <span class="tech-tag">Wireshark</span>
                        <span class="tech-tag">Análisis Logs</span>
                        <span class="tech-tag">Resp. Incidentes</span>
                        <span class="tech-tag">Forense Digital</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Competencias Profesionales -->
        <div class="max-w-4xl mx-auto text-center">
            <h3 class="text-2xl font-bold mb-6 text-[var(--text-color)]">Competencias Profesionales</h3>
            <div class="flex flex-wrap justify-center gap-3">
                <div class="px-5 py-2.5 bg-[var(--card-bg)] rounded-lg border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] text-sm font-medium transition-all">
                    Trabajo en Equipo y Scrum
                </div>
                <div class="px-5 py-2.5 bg-[var(--card-bg)] rounded-lg border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] text-sm font-medium transition-all">
                    Pensamiento Analítico de Seguridad
                </div>
                <div class="px-5 py-2.5 bg-[var(--card-bg)] rounded-lg border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] text-sm font-medium transition-all">
                    Capacidad Autodidacta Permanente
                </div>
                <div class="px-5 py-2.5 bg-[var(--card-bg)] rounded-lg border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] text-sm font-medium transition-all">
                    Resolución de Problemas Complejos
                </div>
                <div class="px-5 py-2.5 bg-[var(--card-bg)] rounded-lg border border-[var(--border-color)] hover:border-[var(--accent-color)] text-[var(--text-color)] text-sm font-medium transition-all">
                    Comunicación Asertiva Técnica
                </div>
            </div>
        </div>
    </div>
</section>
