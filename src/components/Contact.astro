---
// Contact.astro - MONOCROMO TOTAL (sin verde WhatsApp)
---

<section id="contact" class="py-12 md:py-16 relative">
  <div class="container mx-auto px-4 relative z-10">
    <!-- Encabezado Editorial con Nº -->
    <div class="section-header animate-[fadeInUp_0.6s_ease-out]">
      <div class="section-header-inner">
        <div class="section-header-title">
          <div class="flex items-center gap-3 mb-1">
            <span class="section-number">06</span>
            <hr class="section-divider" />
          </div>
          <h2>Hablemos</h2>
          <p>¿Tienes un proyecto, una auditoría pendiente o una idea de software? Hablemos directamente.</p>
        </div>
      </div>
    </div>

    <!-- Canales de Contacto Directos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto mb-12">
      <!-- Email -->
      <a href="mailto:duberney22915@gmail.com"
         class="cyber-card p-8 transition-all hover:-translate-y-1.5 flex flex-col items-center text-center group">
        <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[CHANNEL: SECURE_MAIL]</div>
        <div class="icon-box icon-box-lg mb-5 group-hover:bg-[var(--accent-color)] group-hover:text-black transition-all">
          <i class="fas fa-envelope"></i>
        </div>
        <h3 class="text-xl font-bold mb-2 text-[var(--text-color)]">
          Email
        </h3>
        <p class="text-xs text-[var(--text-muted)] mb-3 font-mono">Respuesta habitual en 24 horas</p>
        <p class="text-sm text-[var(--accent-color)] font-semibold break-all font-mono">duberney22915@gmail.com</p>

        <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[var(--text-muted)] group-hover:text-[var(--accent-color)] transition-colors font-mono">
          <span>Enviar correo</span>
          <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </div>
      </a>

      <!-- WhatsApp (Color WhatsApp Real) -->
      <a href="https://wa.me/573145716188?text=Hola,%20me%20gustar%C3%ADa%20hablar%20sobre%20un%20proyecto"
         target="_blank"
         rel="noopener noreferrer"
         class="cyber-card p-8 transition-all hover:-translate-y-1.5 flex flex-col items-center text-center group hover:border-[#25d366] hover:shadow-[0_0_15px_rgba(37,211,102,0.15)]">
        <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[CHANNEL: DIRECT_IM]</div>
        <div class="icon-box icon-box-lg mb-5 !bg-[rgba(37,211,102,0.08)] !text-[#25d366] group-hover:!bg-[#25d366] group-hover:!text-black transition-all">
          <i class="fab fa-whatsapp"></i>
        </div>
        <h3 class="text-xl font-bold mb-2 text-[var(--text-color)]">
          WhatsApp
        </h3>
        <p class="text-xs text-[var(--text-muted)] mb-3 font-mono">Respuesta inmediata o en minutos</p>
        <p class="text-sm text-[#25d366] font-semibold font-mono">+57 314 571 6188</p>

        <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[var(--text-muted)] group-hover:text-[#25d366] transition-colors font-mono">
          <span>Iniciar conversación</span>
          <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </div>
      </a>

      <!-- LinkedIn (Color LinkedIn Real) -->
      <a href="https://linkedin.com/in/tu-usuario"
         target="_blank"
         rel="noopener noreferrer"
         class="cyber-card p-8 transition-all hover:-translate-y-1.5 flex flex-col items-center text-center group hover:border-[#0077b5] hover:shadow-[0_0_15px_rgba(0,119,181,0.15)]">
        <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[CHANNEL: PROF_NET]</div>
        <div class="icon-box icon-box-lg mb-5 !bg-[rgba(0,119,181,0.08)] !text-[#0077b5] group-hover:!bg-[#0077b5] group-hover:!text-black transition-all">
          <i class="fab fa-linkedin-in"></i>
        </div>
        <h3 class="text-xl font-bold mb-2 text-[var(--text-color)]">
          LinkedIn
        </h3>
        <p class="text-xs text-[var(--text-muted)] mb-3 font-mono">Red profesional y laboral</p>
        <p class="text-sm text-[#0077b5] font-semibold font-mono">Conectar en LinkedIn</p>

        <div class="mt-5 flex items-center gap-1.5 text-xs font-bold text-[var(--text-muted)] group-hover:text-[#0077b5] transition-colors font-mono">
          <span>Ver perfil profesional</span>
          <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
        </div>
      </a>
    </div>

    <!-- Disponibilidad y Horarios -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-16">
      <!-- Disponibilidad Técnica -->
      <div class="cyber-card p-6">
        <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[STATUS: RESOURCE_AVAIL]</div>
        <h3 class="text-lg font-bold mb-4 text-[var(--text-color)] flex items-center gap-2">
          <i class="fas fa-calendar-check text-[var(--accent-color)]"></i>
          Disponibilidad
        </h3>
        <div class="space-y-3.5 text-sm font-mono">
          <div class="flex justify-between items-center py-1 border-b border-[var(--border-color)]/60">
            <span class="text-[var(--text-muted)]">Proyectos Freelance</span>
            <span class="px-2.5 py-0.5 rounded-md bg-[var(--accent-light)] text-[var(--accent-color)] font-bold text-xs border border-[var(--accent-border)]">Disponible</span>
          </div>
          <div class="flex justify-between items-center py-1 border-b border-[var(--border-color)]/60">
            <span class="text-[var(--text-muted)]">Respuesta Inicial</span>
            <span class="text-[var(--text-color)] font-semibold">Menos de 24 horas</span>
          </div>
          <div class="flex justify-between items-center py-1 border-b border-[var(--border-color)]/60">
            <span class="text-[var(--text-muted)]">Ubicación</span>
            <span class="text-[var(--text-color)] font-semibold">Colombia (UTC-5)</span>
          </div>
          <div class="flex justify-between items-center py-1">
            <span class="text-[var(--text-muted)]">Modalidad preferida</span>
            <span class="text-[var(--text-color)] font-semibold">Remoto / Híbrido</span>
          </div>
        </div>
      </div>

      <!-- Horarios -->
      <div class="cyber-card p-6">
        <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[STATUS: SCHEDULE]</div>
        <h3 class="text-lg font-bold mb-4 text-[var(--text-color)] flex items-center gap-2">
          <i class="fas fa-clock text-[var(--accent-color)]"></i>
          Horario de Atención
        </h3>
        <div class="space-y-4 text-sm text-[var(--text-muted)] font-mono">
          <div class="flex items-start gap-3">
            <i class="fas fa-circle-check text-[var(--accent-color)] mt-0.5 text-xs"></i>
            <div>
              <p class="text-[var(--text-color)] font-semibold">Lunes a Viernes</p>
              <p class="text-xs text-[var(--text-subtle)]">09:00 AM - 06:00 PM (Hora Colombia)</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <i class="fas fa-circle-check text-[var(--accent-color)] mt-0.5 text-xs"></i>
            <div>
              <p class="text-[var(--text-color)] font-semibold">Sábados</p>
              <p class="text-xs text-[var(--text-subtle)]">10:00 AM - 02:00 PM (Hora Colombia)</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <i class="fas fa-circle-info text-[var(--accent-color)] mt-0.5 text-xs"></i>
            <div>
              <p class="text-[var(--text-color)] font-semibold">Proyectos Críticos</p>
              <p class="text-xs text-[var(--text-subtle)]">Monitoreo continuo según acuerdo de soporte.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA Final -->
    <div class="max-w-2xl mx-auto cyber-card p-8 text-center">
      <div class="absolute top-2 right-3 font-mono text-[8px] text-[var(--text-subtle)] select-none">[NOTICE: CONNECTION_INIT]</div>
      <div class="icon-box mx-auto mb-4">
        <i class="fas fa-rocket"></i>
      </div>
      <h3 class="text-2xl font-bold mb-3 text-[var(--text-color)]">
        ¿Iniciamos tu próximo proyecto de software?
      </h3>
      <p class="text-sm text-[var(--text-muted)] mb-6 max-w-lg mx-auto leading-relaxed">
        Cuéntame las metas de tu empresa, los requisitos tecnológicos o la infraestructura a auditar. Te responderé con una cotización preliminar.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="mailto:duberney22915@gmail.com" class="btn-primary w-full sm:w-auto justify-center">
          <i class="fas fa-envelope"></i>
          Enviar Correo
        </a>
        <a href="https://wa.me/573145716188?text=Hola,%20me%20gustar%C3%ADa%20hablar%20sobre%20un%20proyecto"
           target="_blank"
           rel="noopener noreferrer"
           class="btn-secondary w-full sm:w-auto justify-center hover:!border-[#25d366] hover:!text-[#25d366] hover:!bg-[#25d366]/10">
          <i class="fab fa-whatsapp"></i>
          Chat WhatsApp
        </a>
      </div>
    </div>
  </div>
</section>
