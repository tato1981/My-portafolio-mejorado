---
// Usa el layout principal
import Layout from '../layouts/Layout.astro';

const title = "¡Mensaje Enviado!";
const description = "Gracias por contactarme. Responderé pronto.";
---

<Layout title={title} description={description}>
  <div class="flex items-center justify-center min-h-[70vh] px-4">
    <div class="bg-[var(--card-bg)] border border-[var(--border-color)] rounded-xl p-8 text-center max-w-2xl w-full shadow-sm">
      <div class="w-16 h-16 rounded-full bg-blue-600/10 dark:bg-blue-500/10 flex items-center justify-center text-blue-600 dark:text-blue-400 text-3xl mx-auto mb-6">
        <i class="fas fa-circle-check"></i>
      </div>
      <h1 class="text-3xl md:text-5xl font-extrabold text-[var(--text-color)] mb-4 tracking-tight">
        ¡Gracias por escribirme!
      </h1>
      <p class="text-base md:text-lg text-[var(--text-muted)] mb-8 leading-relaxed">
        He recibido tu mensaje con éxito. Me pondré en contacto contigo a la brevedad, usualmente en menos de 24 horas.
      </p>
      <a
        href="/"
        class="btn-primary"
      >
        ← Volver al inicio
      </a>
    </div>
  </div>
</Layout>