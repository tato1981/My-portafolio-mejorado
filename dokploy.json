{
  "name": "my-portafolio",
  "type": "dockerfile",
  "dockerfile": "./Dockerfile",
  "buildArgs": {
    "NODE_VERSION": "20"
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "80"
  },
  "ports": [
    {
      "internal": 80,
      "external": 80,
      "protocol": "http"
    }
  ],
  "healthcheck": {
    "enabled": true,
    "path": "/health",
    "interval": 30,
    "timeout": 3,
    "retries": 3
  },
  "resources": {
    "memory": "512Mi",
    "cpu": "0.5"
  },
  "restart": "unless-stopped"
}
